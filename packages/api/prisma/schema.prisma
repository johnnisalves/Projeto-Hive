generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
  THREADS
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String?
  role           Role            @default(OWNER)
  ownerId        String?
  owner          User?           @relation("TeamMembers", fields: [ownerId], references: [id])
  members        User[]          @relation("TeamMembers")
  posts          Post[]
  tasks          Task[]
  projects       Project[]
  funnels        Funnel[]
  videoClips     VideoClip[]
  settings       Setting[]
  instagramTokens InstagramToken[]
  socialAccounts  SocialAccount[]
  invitations    Invitation[]
  brands         Brand[]
  igContacts     IgContact[]
  competitors    Competitor[]
  allowedPages   String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId])
}

model Brand {
  id              String   @id @default(uuid())
  name            String
  logoUrl         String?
  primaryColor    String   @default("#6C5CE7")
  secondaryColor  String   @default("#E84393")
  accentColor     String?
  backgroundColor String?
  textColor       String?
  mutedColor      String?
  fontFamily      String?
  headingFont     String?
  bodyFont        String?
  description     String?
  voiceTone       String?
  websiteUrl      String?
  instagramUrl    String?
  phone           String?
  artDirection    String?
  products        String[] @default([])
  defaultHashtags String[] @default([])
  defaultPlatforms String[] @default(["INSTAGRAM"])
  tonePrompt      String?
  stylePrompt     String?
  isDefault       Boolean  @default(false)
  // Token do portal publico de aprovacao. Nulo = portal desligado.
  // Quem tem o link ve os posts desta marca sem login, entao ele e tratado
  // como segredo: sorteado com 32 bytes e revogavel a qualquer momento.
  approvalToken   String?  @unique
  // Mix de pilares desejado. Sao PESOS relativos, nao percentuais: 3/4/3
  // e 30/40/30 dao o mesmo resultado, e assim o usuario nao precisa fechar
  // a conta em 100.
  // Endereco publico do link-in-bio. Nulo = pagina desligada.
  bioSlug         String?  @unique
  bioLinks        BioLink[]
  mixVender       Int      @default(3)
  mixEducar       Int      @default(4)
  mixEngajar      Int      @default(3)
  posts           Post[]
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Invitation {
  id           String    @id @default(uuid())
  email        String
  role         Role      @default(EDITOR)
  token        String    @unique @default(uuid())
  expiresAt    DateTime
  usedAt       DateTime?
  allowedPages String[]  @default([])
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([ownerId])
  @@index([token])
}

model Post {
  id              String      @id @default(uuid())
  caption         String?
  imageUrl        String?
  imageSource     ImageSource @default(NANOBANA)
  nanoPrompt      String?
  status          PostStatus  @default(DRAFT)
  approvalState   String      @default("none")
  sendWhatsappStatus Boolean  @default(false)
  isEvergreen     Boolean     @default(false)
  evergreenIntervalDays Int   @default(7)
  evergreenLastRunAt DateTime?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  instagramId     String?
  source          PostSource  @default(WEB)
  hashtags        String[]
  aspectRatio     String      @default("1:1")
  isCarousel      Boolean     @default(false)
  mediaType       MediaType   @default(IMAGE)
  publishMode     PublishMode @default(FEED)
  videoUrl        String?
  videoMinioKey   String?
  videoDurationSec Int?
  videoSizeBytes  Int?
  keepMedia       Boolean     @default(false)
  lastError       String?
  editorState     Json?
  driveLink       String?
  fileUrl         String?
  platforms       SocialPlatform[] @default([INSTAGRAM])
  publishedResults Json?

  // --- Recursos de publicacao do Instagram ---
  // Marcacao de pessoas: [{ username, x, y, imageIndex? }] com x/y de 0.0 a 1.0
  userTags        Json?
  // Colaboradores (o post aparece no perfil de todos) — a API aceita ate 3
  collaborators   String[] @default([])
  // ID da Pagina de local (a API exige Page ID, nao texto livre)
  locationId      String?
  // Texto alternativo de acessibilidade — so vale para imagem, ate 1000 chars
  altText         String?
  // Reels: true mostra tambem no Feed; false deixa so na aba Reels
  shareToFeed     Boolean  @default(true)
  // Nome do audio original do Reels (so pode ser definido uma vez)
  audioName       String?
  // Capa do Reels: imagem propria ou o frame em milissegundos
  coverUrl        String?
  thumbOffsetMs   Int?
  // Declaracao de conteudo gerado por IA (exigencia de politica do Meta)
  isAiGenerated   Boolean  @default(false)
  // Publipost: marca "Parceria paga" e os perfis patrocinadores (ate 2)
  isPaidPartnership Boolean @default(false)
  sponsorIds      String[] @default([])
  // Trilha de audio mixada no video antes do upload (ver audio-mixer.service)
  audioUrl        String?
  audioVolume     Int?
  // URL do video ja mixado, para nao remixar a cada tentativa de publicacao
  mixedVideoUrl   String?
  // Reels de teste: sai so para nao-seguidores; se performar, vira publico
  isTrialReel     Boolean  @default(false)
  // Reciclagem: aponta para o post original que deu origem a este.
  // Guardado para nao reciclar o mesmo conteudo em ciclo e para o
  // historico mostrar de onde a arte veio.
  recycledFromId  String?
  recycledAt      DateTime?
  // Pilar do post: vender, educar ou engajar. Preenchido pelo piloto
  // automatico; nos demais e inferido da legenda na hora de analisar.
  pilar           String?
  // Hashtags no primeiro comentario em vez da legenda: deixa o texto limpo
  // no feed sem perder o alcance das tags.
  hashtagsFirstComment Boolean @default(false)
  brandId         String?
  brand           Brand?      @relation(fields: [brandId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  images          PostImage[]
  feedbacks       PostFeedback[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([userId])
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
}

enum PublishMode {
  FEED
  REELS
  STORIES
}

/**
 * Comentario do cliente no portal de aprovacao.
 *
 * Fica em tabela propria, e nao num campo do Post, porque a conversa tem
 * varias idas e voltas ("troca a foto" -> "assim ficou bom") e o historico
 * e o que evita retrabalho depois.
 */
/**
 * Botao da pagina de link-in-bio.
 *
 * clicks e um contador simples, nao tabela de eventos: para saber qual
 * botao funciona, o total basta, e guardar cada clique geraria volume sem
 * responder pergunta nova.
 */
model BioLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  order     Int      @default(0)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([brandId])
}

model PostFeedback {
  id        String   @id @default(uuid())
  message   String
  /** Nome que a pessoa digitou no portal. Sem login, e o que temos. */
  author    String?
  /** true quando veio do dono da conta, nao do cliente. */
  fromOwner Boolean  @default(false)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}

model PostImage {
  id        String      @id @default(uuid())
  imageUrl  String
  minioKey  String?
  order     Int         @default(0)
  source    ImageSource @default(NANOBANA)
  prompt    String?
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([postId])
  @@unique([postId, order])
}

// Agenda de @ usados nos posts (marcacao, colaborador, patrocinador).
//
// POR QUE EXISTE: a API do Instagram nao tem busca de usuario por prefixo —
// so o business_discovery, que exige o @ exato. Entao o autocomplete vem da
// propria agenda: todo @ usado fica salvo e volta como sugestao depois.
model IgContact {
  id          String   @id @default(uuid())
  username    String
  displayName String?
  // Preenchido quando o business_discovery confirma o perfil
  verifiedAt  DateTime?
  followers   Int?
  // Ordena as sugestoes: quem voce mais usa aparece primeiro
  useCount    Int      @default(1)
  lastUsedAt  DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, username])
  @@index([userId])
}

/**
 * Perfil acompanhado no radar de concorrentes.
 *
 * Os numeros sao uma FOTO do ultimo check, nao historico: guardamos o
 * anterior lado a lado para mostrar a variacao sem precisar de uma tabela
 * de series temporais, que seria exagero para 5 perfis.
 */
model Competitor {
  id             String    @id @default(uuid())
  username       String
  displayName    String?
  followers      Int?
  mediaCount     Int?
  /** Valores do check anterior, para calcular a variacao. */
  prevFollowers  Int?
  prevMediaCount Int?
  /** Posts nos ultimos 30 dias, calculado no check. */
  postsLast30    Int?
  /** Media de curtidas dos posts recentes. */
  avgLikes       Int?
  lastCheckedAt  DateTime?
  lastError      String?
  brandId        String?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([userId, username])
  @@index([userId])
}

model InstagramToken {
  id              String   @id @default(uuid())
  accessToken     String
  instagramUserId String
  username        String?
  pageId          String?
  isDefault       Boolean  @default(false)
  expiresAt       DateTime
  refreshedAt     DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Conexao WhatsApp (UAZ API) para publicar no Status do WhatsApp
model WhatsappConnection {
  id        String   @id @default(uuid())
  name      String
  host      String
  token     String
  phone     String?
  isDefault Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SocialAccount {
  id              String          @id @default(uuid())
  platform        SocialPlatform
  accessToken     String
  refreshToken    String?
  platformUserId  String
  username        String?
  displayName     String?
  pageId          String?
  isDefault       Boolean         @default(false)
  expiresAt       DateTime?
  refreshedAt     DateTime        @default(now())
  userId          String
  brandId         String?
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([platform])
  @@index([brandId])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
}

enum ImageSource {
  NANOBANA
  UPLOAD
  URL
}

enum PostSource {
  WEB
  TELEGRAM
  MCP
}

// === Task & Project enums ===

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskPlatform {
  YOUTUBE
  INSTAGRAM
  META_ADS
  TIKTOK
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

// === Task & Project models ===

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  platform        TaskPlatform @default(OTHER)
  status          TaskStatus   @default(PENDING)
  priority        TaskPriority @default(MEDIUM)
  recordDate      DateTime?
  publishDate     DateTime?
  script          String?
  scriptFileUrl   String?
  driveLink       String?
  isSponsored     Boolean      @default(false)
  sponsorName     String?
  sponsorBriefing String?
  briefingFileUrl String?
  sponsorContact  String?
  sponsorDeadline DateTime?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([recordDate])
  @@index([publishDate])
  @@index([projectId])
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  modules     ProjectModule[]
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model ProjectModule {
  id         String   @id @default(uuid())
  title      String
  content    String?
  order      Int      @default(0)
  isRecorded Boolean  @default(false)
  driveLink  String?
  fileUrl    String?
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@unique([projectId, order])
}

// === Funnel enums ===

enum FunnelStepType {
  LANDING_PAGE
  LEAD_CAPTURE
  EMAIL_SEQUENCE
  SALES_PAGE
  CHECKOUT
  UPSELL
  THANK_YOU
  WEBINAR
  VIDEO
  SOCIAL_POST
  AD
  OTHER
}

enum FunnelStepStatus {
  TODO
  IN_PROGRESS
  DONE
}

// === Funnel models ===

model Funnel {
  id          String        @id @default(uuid())
  title       String
  description String?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  stages      FunnelStage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model FunnelStage {
  id          String       @id @default(uuid())
  title       String
  description String?
  color       String       @default("#6366f1")
  order       Int          @default(0)
  funnelId    String
  funnel      Funnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  steps       FunnelStep[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([funnelId])
  @@unique([funnelId, order])
}

model FunnelStep {
  id          String           @id @default(uuid())
  title       String
  description String?
  type        FunnelStepType   @default(OTHER)
  link        String?
  status      FunnelStepStatus @default(TODO)
  order       Int              @default(0)
  stageId     String
  stage       FunnelStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([stageId])
  @@unique([stageId, order])
}

// === Video Clip models ===

model Setting {
  id        String   @id @default(uuid())
  key       String
  value     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model VideoClip {
  id        String   @id @default(uuid())
  title     String?
  sourceUrl String
  language  String?
  duration  Int?
  status    String   @default("PENDING") // PENDING, ANALYZING, ANALYZED, CLIPPING, READY, FAILED
  error     String?
  moments   Json?
  clips     Json?
  workDir   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
